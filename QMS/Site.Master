<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="QMS.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
    crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.2.1.slim.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.11.0/umd/popper.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0/js/bootstrap.min.js"></script>
    <style>
    
      body{
        background-color: 
        #c3d1e3;
      }
      .bgwhite{
        background-color:white;
      }
      .pages{
        text-decoration: none;
        color: #dbe2f0;
        text-align: left;
        padding: 20px
      }
      .line{
        margin: 10px 20px;
      }
   
    .time-display {
      font-size: 2em;
      color: green;
      text-align: center;
    }
    .date-display {
      font-size: 5em;
      color: green;
      text-align: center;
    }
    .calendar {
      
      border-radius: 10px;
      padding: 0px;
      background-color: white;
    }
    .calendar-header {
      background-color: #ff9000;
      color: white;
      padding: 10px;
      padding-top: 0px;
      text-align: center;
      border-radius: 10px 10px 0 0;
    }
    .calendar-body {
      text-align: center;
      padding: 10px;
    }
    .month-navigation {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .calendar-footer {
      display: flex;
      justify-content: center;
      padding: 10px;
    }
    
  
  /* Default styles for the sidebar */
 

  .sidebar{
    


        background-color: #271b3f; /* Dark background */
    min-height: 100vh; /* Full height */
   
    top: 0;
    left: 0;
    overflow-y: auto; /* Scrollbar if needed */
    overflow-x:auto;
   
  



      
  }

  .sidebar-content {
          padding: 1rem;
      position:fixed;
    
    
  }

  /* Toggle button styles */
  .navbar-toggler {
      display: none; /* Hide toggle button by default */
  }

  /* Media query for mobile screens */
  @media (max-width: 992px) {
      .sidebar {
        position:fixed;
      top: 0;
      left: 0;
     display: none;
     
      transition: transform 0.3s ease; /* Smooth transition effect */
      z-index: 1000; /* Ensure sidebar is above content */
      }

      .navbar-toggler {
          display: block; /* Display toggle button on mobile screens */
          
          top: 15px;
          left: 15px;
          z-index: 1100; /* Ensure toggle button is above sidebar */
          background-color: #fff; /* Example background color */
          border: none;
          padding: 10px;
          cursor: pointer;
      }

      .sidebar.open {
          display: block; /* Display sidebar when 'open' class is added on mobile screens */
          transform: translateX(0); /* Slide in from the left */
      }
  }
    
  
</style>

</head>
<body>
    <form runat="server">
       
  <section>
    <div class="container-fluid">
      <div class="row">
        <div class="sidebar col-md-2 d-md-block" >
          <div class="sidebar-content" >
              <div class="image">
                  <img class="text-center" src="logo.jpg" alt="" style="border: 1px solid darkred; border-radius: 50%; width: 100px; height: 100px; display: block; margin: auto; margin-top: 50px;">
                  
                  <p class="text-center mt-2" style="color: white;"><%= GetBankName() %></p>
              </div>
              <div class="pages" style="color: #dbe2f0; padding: 15px;">
                  <p><b>QMS</b></p>

                  <div class="sub_page">
                      <asp:HiddenField  ID="mail" runat="server"/>
    <asp:LinkButton class="pages" ID="lnkDashboard" runat="server" OnClick="lnkDashboard_Click">Dashboard</asp:LinkButton>
    <hr class="line"/>
    <asp:LinkButton class="pages" ID="lnkReports" runat="server" OnClick="lnkReports_Click">Reports</asp:LinkButton>
    <hr class="line"/>
    <asp:LinkButton class="pages" ID="lnkStaffRegistration" runat="server" OnClick="lnkStaffRegistration_Click" style="white-space: nowrap;">Staff Registration</asp:LinkButton>
    <hr class="line"/>
    <asp:LinkButton class="pages" ID="lnkAttendance" runat="server" OnClick="lnkAttendance_Click">Attendance</asp:LinkButton>
<hr class="line"/>
 <asp:LinkButton class="pages" ID="UserSignUp" runat="server" OnClick="lnkUserRegistration_Click" >User Registration</asp:LinkButton>
<hr class="line"/>
                       <asp:LinkButton class="pages" ID="Qrcode" runat="server" OnClick="lnkqrcode_Click" >Generate QR code</asp:LinkButton>
<hr class="line"/>
  
 
</div>
            <!--      <div class="sub_page">
                      <a href="dashboard.aspx">Dashboard</a>
                      <hr >
                      <a href="ReportsMainPage.aspx">Reports</a>
                      <hr>
                      
                      <a href="Staffreg.aspx" style="white-space: nowrap;">Staff Registration</a>
                      <hr>
                      <a href="Attendance.aspx">Attendance</a>
                      <hr>
                
                      
                  </div> -->
      
              </div>
        
          </div>
      </div>
           <div class="col-md-10 m-0 p-0"  >
        
         <asp:ContentPlaceHolder ID="MainContent" runat="server">
</asp:ContentPlaceHolder>
       </div>

      </div>
    </div>


  </section>
        
      
    </form>
 
    
    <script>
  function updateTime() {
    const currentTimeElement = document.getElementById('currentTime');
    const now = new Date();
    const formattedTime = now.toLocaleTimeString();
    currentTimeElement.textContent = formattedTime;
  }

  function updateCalendar() {
    const now = new Date();
    const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
    const monthYearElement = document.getElementById('monthYear');
    const currentDateElement = document.getElementById('currentDate');
    const calendarElement = document.getElementById('calendar');

    monthYearElement.textContent = `${monthNames[now.getMonth()]} ${now.getFullYear()}`;
    currentDateElement.textContent = now.getDate();

    const firstDay = new Date(now.getFullYear(), now.getMonth(), 1).getDay();
    const daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();

    calendarElement.innerHTML = "";

    const daysOfWeek = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    let calendarHTML = "<div class='d-flex justify-content-between'>";
    daysOfWeek.forEach(day => {
      calendarHTML += `<div class='p-2' style='width: 14.28%;'>${day}</div>`;
    });
    calendarHTML += "</div>";

    calendarHTML += "<div class='d-flex flex-wrap'>";
    for (let i = 0; i < firstDay; i++) {
      calendarHTML += `<div class='p-2' style='width: 14.28%;'></div>`;
    }

    for (let i = 1; i <= daysInMonth; i++) {
      const dayStyle = (i === now.getDate()) ? "font-weight-bold text-success" : "";
      calendarHTML += `<div class='p-2 ${dayStyle}' style='width: 14.28%;'>${i}</div>`;
    }
    calendarHTML += "</div>";

    calendarElement.innerHTML = calendarHTML;
  }

  document.getElementById('prevMonth').addEventListener('click', function() {
    // Add functionality to move to the previous month
  });

  document.getElementById('nextMonth').addEventListener('click', function() {
    // Add functionality to move to the next month
  });

  // Update time every second
  setInterval(updateTime, 1000);

  // Initial call to display the time and calendar immediately
  updateTime();
  updateCalendar();
  // Toggle sidebar open/close on button click
document.querySelector('.navbar-toggler').addEventListener('click', function() {
    document.querySelector('.sidebar').classList.toggle('open');
});
    </script>
</body>
</html>
